{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source note",
  "type": "object",
  "required": [
    "id",
    "type",
    "status",
    "authority",
    "title"
  ],
  "properties": {
    "type": {
      "const": "source"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "source_path"
        ]
      },
      "then": {
        "required": [
          "mirror",
          "sha256"
        ]
      }
    }
  ]
}
