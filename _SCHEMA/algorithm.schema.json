{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "type",
    "status",
    "authority",
    "title",
    "implemented_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
    },
    "type": {
      "const": "algorithm"
    },
    "status": {
      "enum": [
        "canonical",
        "active",
        "draft",
        "proposed",
        "pending-fix",
        "deprecated",
        "superseded",
        "archived"
      ]
    },
    "authority": {
      "enum": [
        "normative",
        "executable",
        "empirical",
        "historical",
        "non-canonical"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implemented_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "title": "algorithm note"
}
