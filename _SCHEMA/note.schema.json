{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vault note frontmatter",
  "type": "object",
  "required": [
    "id",
    "type",
    "status",
    "authority",
    "title",
    "related_entities",
    "source_reference"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
    },
    "type": {
      "enum": [
        "system",
        "core",
        "market",
        "behavior",
        "algorithm",
        "source",
        "mirror",
        "test",
        "case",
        "data",
        "workflow",
        "version",
        "decision"
      ]
    },
    "status": {
      "enum": [
        "active",
        "canonical",
        "draft",
        "pending"
      ]
    },
    "authority": {
      "enum": [
        "normative",
        "executable",
        "empirical",
        "non-canonical"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "related_entities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "source_reference": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^06_SOURCE/Code/[A-Za-z0-9_./-]+(?:#L[1-9][0-9]*)?$"
      },
      "uniqueItems": true
    },
    "fixture_kind": {
      "enum": [
        "Confirmed",
        "Regression",
        "EdgeCase",
        "Bug"
      ]
    },
    "fixture_status": {
      "enum": [
        "Active",
        "Pending"
      ]
    },
    "fixture_authority": {
      "enum": [
        "Canonical",
        "Pending"
      ]
    },
    "direction": {
      "enum": [
        "Bullish",
        "Bearish",
        "unknown"
      ]
    },
    "timeframe": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*s|unknown)$"
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_window_first_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "dataset_window_last_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "dataset_window_row_count": {
      "type": "integer",
      "minimum": 1
    },
    "dataset_window_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}|unknown)$"
    },
    "behavior": {
      "type": "string",
      "minLength": 1
    },
    "behavior_detail": {
      "type": "string",
      "minLength": 1
    },
    "algorithm": {
      "type": "string",
      "pattern": "^(?:algorithm\\.[a-z0-9_.]+|unknown)$"
    },
    "source_module": {
      "type": "string",
      "pattern": "^(?:06_SOURCE/Code/engine/[A-Za-z0-9_./-]+\\.py|unknown)$"
    },
    "source_function": {
      "type": "string",
      "minLength": 1
    },
    "reaction_identity": {
      "oneOf": [
        {
          "const": "unknown"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "order_identity": {
      "oneOf": [
        {
          "const": "unknown"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "first_index": {
      "oneOf": [
        {
          "const": "unknown"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "break_index": {
      "oneOf": [
        {
          "const": "unknown"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "minLength": 1
    },
    "previous_behavior": {
      "type": "string",
      "minLength": 1
    },
    "next_behavior": {
      "type": "string",
      "minLength": 1
    },
    "stopall_boundary": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "expected_output": {
      "type": "string",
      "minLength": 1
    },
    "validation_target": {
      "type": "string",
      "minLength": 1
    },
    "validation_rule": {
      "type": "string",
      "pattern": "^test\\.[a-z0-9_.]+$"
    },
    "source_fixture": {
      "type": "string",
      "minLength": 1
    },
    "source_fixture_line": {
      "type": "integer",
      "minimum": 1
    },
    "source_fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "data_kind": {
      "enum": [
        "policy",
        "registry",
        "raw_model",
        "candle_model",
        "timeframe_registry",
        "integrity",
        "hash_policy",
        "lineage",
        "validation",
        "template",
        "dataset",
        "window",
        "raw_format",
        "raw_schema",
        "raw_authority",
        "hash_registry",
        "manifest"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reference_agreement": {
      "enum": ["match", "conflict", "ambiguous", "not-applicable"]
    },
    "reference_conflicts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "instrument": {
      "type": "string",
      "minLength": 1
    },
    "broker": {
      "type": "string",
      "minLength": 1
    },
    "resolution": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*s|unknown)$"
    },
    "start_time": {
      "type": "string",
      "minLength": 1
    },
    "end_time": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "enum": [
        "Asia/Tehran",
        "unknown"
      ]
    },
    "direction_support": {
      "type": "array",
      "items": {
        "enum": [
          "Bullish",
          "Bearish"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "consumed_by_algorithms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^algorithm\\.[a-z0-9_.]+$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "produces_behaviors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^behavior\\.[a-z0-9_.]+$"
      },
      "uniqueItems": true
    },
    "used_by_fixtures": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^case\\.[a-z0-9_.]+$"
      },
      "uniqueItems": true
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^test\\.[a-z0-9_.]+$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "chronology_model": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
    },
    "regression_role": {
      "enum": [
        "fixture-backed",
        "available-unanchored"
      ]
    },
    "hash_reference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
    },
    "raw_path": {
      "type": "string",
      "minLength": 1
    },
    "raw_locations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "retained_raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_dataset": {
      "type": "string",
      "pattern": "^data\\.dataset_[0-9a-f]{8}$"
    },
    "original_raw_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "raw_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "row_count": {
      "type": "integer",
      "minimum": 1
    },
    "first_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "last_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "integrity_status": {
      "enum": [
        "verified",
        "pending_metadata_conflict"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^06_SOURCE/Code/[A-Za-z0-9_./-]+(?:#L[1-9][0-9]*)?$"
      },
      "uniqueItems": true
    },
    "source_path": {
      "type": "string",
      "pattern": "^06_SOURCE/Code/[A-Za-z0-9_./-]+$"
    },
    "mirror": {
      "type": "string",
      "pattern": "^06_SOURCE/Code/[A-Za-z0-9_./-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "valid_for_reasoning": {
      "type": "boolean"
    },
    "valid_for_validation": {
      "type": "boolean"
    },
    "valid_for_regression_baseline": {
      "type": "boolean"
    },
    "calculated_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "implemented_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "produces": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "parent_of": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "child_of": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "relates_to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "orchestrates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "direction_sensitivity": {
      "type": "string",
      "minLength": 1
    },
    "evidence_basis": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "algorithm_reference": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "mirror_links": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "canonical"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "const": "normative"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "source_path"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "const": "source"
          },
          "authority": {
            "const": "executable"
          }
        },
        "required": [
          "mirror",
          "sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "algorithm",
              "behavior"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "implemented_by"
        ],
        "properties": {
          "implemented_by": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
