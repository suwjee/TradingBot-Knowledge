{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vault note frontmatter",
  "type": "object",
  "required": [
    "id",
    "type",
    "status",
    "authority",
    "title",
    "related_entities",
    "source_reference"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
    },
    "type": {
      "enum": [
        "system",
        "core",
        "market",
        "behavior",
        "algorithm",
        "source",
        "mirror",
        "test",
        "case",
        "data"
      ]
    },
    "status": {
      "enum": [
        "canonical",
        "active",
        "draft",
        "proposed",
        "pending-fix",
        "deprecated",
        "superseded",
        "archived"
      ]
    },
    "authority": {
      "enum": [
        "normative",
        "canonical",
        "executable",
        "empirical",
        "historical",
        "non-canonical"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "related_entities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "source_reference": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^engine/[A-Za-z0-9_./-]+#L[1-9][0-9]*$"
      },
      "uniqueItems": true
    },
    "fixture_kind": { "enum": ["Confirmed", "Regression", "EdgeCase", "Bug"] },
    "fixture_status": { "enum": ["Active", "Pending", "Historical"] },
    "fixture_authority": { "enum": ["Canonical", "Pending", "Historical"] },
    "direction": { "enum": ["Bullish", "Bearish", "unknown"] },
    "timeframe": { "type": "string", "pattern": "^(?:[1-9][0-9]*s|unknown)$" },
    "dataset": { "type": "string", "minLength": 1 },
    "dataset_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}|unknown)$" },
    "behavior": { "enum": ["A", "S", "E", "StopAll", "unknown"] },
    "behavior_detail": { "type": "string", "minLength": 1 },
    "algorithm": { "type": "string", "pattern": "^(?:algorithm\\.[a-z0-9_.]+|unknown)$" },
    "source_module": { "type": "string", "pattern": "^(?:engine/(?:pipeline|bridge)/[a-z0-9_]+\\.py|unknown)$" },
    "source_function": { "type": "string", "minLength": 1 },
    "reaction_identity": { "oneOf": [{ "const": "unknown" }, { "type": "array", "prefixItems": [{"type":"integer","minimum":0},{"type":"integer","minimum":0}], "minItems": 2, "maxItems": 2 }] },
    "order_identity": { "oneOf": [{ "const": "unknown" }, { "type": "array", "prefixItems": [{"type":"integer","minimum":0},{"type":"integer","minimum":0}], "minItems": 2, "maxItems": 2 }] },
    "lifecycle_state": { "type": "string", "minLength": 1 },
    "previous_behavior": { "type": "string", "minLength": 1 },
    "next_behavior": { "type": "string", "minLength": 1 },
    "stopall_boundary": { "oneOf": [{ "type": "boolean" }, { "const": "unknown" }] },
    "expected_output": { "type": "string", "minLength": 1 },
    "validation_target": { "type": "string", "minLength": 1 },
    "validation_rule": { "type": "string", "pattern": "^test\\.[a-z0-9_.]+$" },
    "source_fixture": { "type": "string", "minLength": 1 },
    "source_fixture_line": { "type": "integer", "minimum": 1 },
    "source_fixture_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "data_kind": { "enum": ["policy", "registry", "raw_model", "candle_model", "timeframe_registry", "integrity", "hash_policy", "lineage", "validation", "template", "dataset", "raw_format", "raw_schema", "raw_authority", "hash_registry", "manifest"] },
    "name": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "market": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "instrument": { "type": "string", "minLength": 1 },
    "broker": { "type": "string", "minLength": 1 },
    "resolution": { "type": "string", "pattern": "^(?:[1-9][0-9]*s|unknown)$" },
    "start_time": { "type": "string", "minLength": 1 },
    "end_time": { "type": "string", "minLength": 1 },
    "timezone": { "enum": ["Asia/Tehran", "unknown"] },
    "direction_support": { "type": "array", "items": { "enum": ["Bullish", "Bearish"] }, "uniqueItems": true, "minItems": 1 },
    "consumed_by_algorithms": { "type": "array", "items": { "type": "string", "pattern": "^algorithm\\.[a-z0-9_.]+$" }, "uniqueItems": true, "minItems": 1 },
    "produces_behaviors": { "type": "array", "items": { "type": "string", "pattern": "^behavior\\.[a-z0-9_.]+$" }, "uniqueItems": true },
    "used_by_fixtures": { "type": "array", "items": { "type": "string", "pattern": "^case\\.[a-z0-9_.]+$" }, "uniqueItems": true },
    "validated_by": { "type": "array", "items": { "type": "string", "pattern": "^test\\.[a-z0-9_.]+$" }, "uniqueItems": true, "minItems": 1 },
    "chronology_model": { "const": "core.chronology" },
    "regression_role": { "enum": ["fixture-backed", "available-unanchored"] },
    "hash_reference": { "const": "data.hash_registry" },
    "raw_path": { "type": "string", "minLength": 1 },
    "raw_locations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "minItems": 1 },
    "raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "raw_bytes": { "type": "integer", "minimum": 1 },
    "row_count": { "type": "integer", "minimum": 1 },
    "first_epoch": { "type": "integer", "minimum": 1 },
    "last_epoch": { "type": "integer", "minimum": 1 },
    "integrity_status": { "enum": ["verified", "pending_metadata_conflict"] },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:engine|apps/chart)/[A-Za-z0-9_./-]+(?:#L[1-9][0-9]*)?$"
      },
      "uniqueItems": true
    },
    "source_path": {
      "type": "string",
      "pattern": "^engine/(?:bridge|pipeline)/[a-z0-9_]+\\.py$"
    },
    "mirror": {
      "type": "string",
      "pattern": "^06_SOURCE/Code/engine/(?:bridge|pipeline)/[a-z0-9_]+\\.py$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_gate_type": {
      "enum": [
        "sequence-group-stop",
        "stopall-stop",
        "opposite-s-group-stop"
      ]
    },
    "external_source_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:engine|apps/chart)/[A-Za-z0-9_./-]+$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "calculated_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "implemented_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "produces": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "parent_of": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "child_of": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "relates_to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "orchestrates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
      },
      "uniqueItems": true
    },
    "external_source_hashes": {
      "type": "object",
      "patternProperties": {
        "^(?:engine|apps/chart)/[A-Za-z0-9_./-]+$": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "not": { "const": "system" } } }, "required": ["type"] },
      "then": { "properties": { "source_reference": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "type": { "const": "test" } }, "required": ["type"] },
      "then": { "required": ["related_entities", "source_reference"], "properties": { "related_entities": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "type": { "const": "case" } }, "required": ["type"] },
      "then": { "required": ["related_entities", "source_reference"], "properties": { "related_entities": { "minItems": 2 } } }
    },
    {
      "if": {
        "properties": { "type": { "const": "mirror" } },
        "required": [ "type" ]
      },
      "then": {
        "required": [ "created", "updated", "related_entities", "source_reference" ],
        "properties": {
          "status": { "const": "active" },
          "authority": { "const": "canonical" },
          "related_entities": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "authority": { "const": "canonical" } },
        "required": [ "authority" ]
      },
      "then": { "properties": { "type": { "const": "mirror" } } }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "canonical"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "const": "normative"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending-fix"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "const": "non-canonical"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "const": "algorithm.orderaudit"
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "pending-fix"
          },
          "authority": {
            "const": "non-canonical"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "source_path"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "const": "source"
          },
          "authority": {
            "const": "executable"
          }
        },
        "required": [
          "mirror",
          "sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "behavior"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "calculated_by",
          "implemented_by"
        ],
        "properties": {
          "calculated_by": {
            "minItems": 1
          },
          "implemented_by": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "algorithm"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "implemented_by"
        ],
        "properties": {
          "implemented_by": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
